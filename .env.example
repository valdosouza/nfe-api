# nfe-api — variáveis (copie para .env; NUNCA versione o .env). Molde: nfse-api/.env.example (mesma casa — D-F9/D-F12).
PORT=3003

# Mesma instância MySQL do produto (D-F9). O MESMO usuário das APIs fiscais (nfse-api/ops/grants.sql, seção 1 — "nfse-api hoje; nfe-api
# amanhã"): controle total no fiscal_api, leitura (e a trava FOR UPDATE da nota — D-F31) nos schemas setes_*.
DB_HOST=localhost
DB_PORT=3306
DB_USER=fiscal_api
DB_PASSWORD=
FISCAL_DB_NAME=fiscal_api
DB_POOL_SIZE=20

# Chave-mestra do cofre do A1 (D-F16) — a MESMA da nfse-api (o A1 é UM por estabelecimento e serve as duas famílias — D-N31):
# 32 bytes em base64 — "versão:base64[,versão:base64]"; a maior cifra.
# Gerar: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
FISCAL_MASTER_KEYS=

# Chave PÚBLICA RS256 do setes-api (D-F13). UMA chave: JWT_PUBLIC_KEY_PATH = um caminho (kid "default" — IGUAL ao JWT_KID do setes-api).
# Na ROTAÇÃO (PADROES_BANCO §7): JWT_PUBLIC_KEYS="default=./secrets/jwt/anterior.pem,k2=./secrets/jwt/nova.pem". Token sem kid ou sem
# exp é recusado (D-F165).
JWT_PUBLIC_KEY_PATH=./secrets/jwt/setes-api.public.pem

# Arquivo fiscal (XML). No dev: o MESMO STORAGE_PATH do setes-api/nfse-api (a NF-e grava em <cnpj>/<H|P>/<ano>/<mes> — D-NE50).
STORAGE_PATH=../setes-api/storage

# Origens do app web que podem chamar direto (D-F4/D-F9), separadas por vírgula — EXPLÍCITAS por ambiente (D-F146: o boot recusa
# lista vazia e "*"). Dev: a porta do app (5051). Produção: a origem do build no Plesk.
CORS_ORIGINS=http://localhost:5051
