# nfe-api — variáveis (copie para .env; NUNCA versione o .env). Molde: nfse-api/.env.example (mesma casa — D-F9/D-F12).
PORT=3003
# Ambiente. NO SERVIDOR: NODE_ENV=production — OBRIGATÓRIO; é ele que liga o STORAGE_PATH absoluto (P-DEP-2) e o CORS só https sem
# localhost (D-F236). Sem ele o boot sobe como dev (o log do boot diz o ambiente e a raiz do arquivo fiscal).
NODE_ENV=development

# Mesma instância MySQL do produto (D-F9). O MESMO usuário das APIs fiscais (nfse-api/ops/grants.sql, seção 1 — "nfse-api hoje; nfe-api
# amanhã"): controle total no fiscal_api, leitura (e a trava FOR UPDATE da nota — D-F31) nos schemas setes_*.
DB_HOST=localhost
DB_PORT=3306
DB_USER=fiscal_api
DB_PASSWORD=
FISCAL_DB_NAME=fiscal_api
DB_POOL_SIZE=20

# Chave-mestra do cofre do A1 (D-F16) — a MESMA da nfse-api (o A1 é UM por estabelecimento e serve as duas famílias — D-N31):
# 32 bytes em base64 — "versão:base64[,versão:base64]"; a maior cifra.
# Gerar: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
FISCAL_MASTER_KEYS=

# Chave PÚBLICA RS256 do setes-api (D-F13). UMA chave: JWT_PUBLIC_KEY_PATH = um caminho (kid "default" — IGUAL ao JWT_KID do setes-api).
# Na ROTAÇÃO (PADROES_BANCO §7): JWT_PUBLIC_KEYS="default=./secrets/jwt/anterior.pem,k2=./secrets/jwt/nova.pem". Token sem kid ou sem
# exp é recusado (D-F165).
# A chave da auth-api entra como mais um kid na lista (D-AU16): JWT_PUBLIC_KEYS="default=…/setes-api.public.pem,<kid-da-auth-api>=…" —
# a chave REAL e o momento estão PENDENTES (decisão do Valdo). Até a auth-api:AUTH.E2.P5, a troca de senha feita na auth-api NÃO derruba o
# token aqui (a view só lê a senha do setes-api). NUNCA o kid `auth-api-contract-test` do vetor de contrato (par público, só de teste).
JWT_PUBLIC_KEY_PATH=./secrets/jwt/setes-api.public.pem

# Arquivo fiscal (XML). No dev: o MESMO STORAGE_PATH do setes-api/nfse-api; layout D-F241 do núcleo 2.0.0 (substitui o da D-NE50):
# <cnpj>/[H/]<nfe|nfce>/<série>/<ano>/<mês>/<dia>/ (dia na zona do estabelecimento). Em produção (NODE_ENV=production) o caminho é
# OBRIGATÓRIO e ABSOLUTO (`fiscalStorageRootFromEnv`); a raiz tem de existir (o /v1/health não a cria).
STORAGE_PATH=../setes-api/storage

# Origens do app web que podem chamar direto (D-F4/D-F9), separadas por vírgula — EXPLÍCITAS por ambiente (D-F146: o boot recusa
# lista vazia e "*"; D-F236: com NODE_ENV=production só https:// e nada de localhost). Dev: a porta do app (5051). Produção: a
# origem do build no Plesk.
CORS_ORIGINS=http://localhost:5051

# Raízes ICP-Brasil do SERVIDOR da SEFAZ (D-NE187/D-NE202 — NFE.E4.P3.T3): OBRIGATÓRIO; sem o arquivo (ou com ele vencido ou diferente
# da ficha .json ao lado) o serviço NÃO sobe. No dev, a cópia do repositório; no servidor, um caminho fora do dist/ (troca sem build).
SEFAZ_SERVER_CA_PATH=acervo/icp/raizes-icp-brasil.pem
