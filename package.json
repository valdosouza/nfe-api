{
  "name": "nfe-api",
  "version": "0.1.0",
  "private": true,
  "description": "Serviço da NF-e / NFC-e (SEFAZ) do Gestão 2027 — porta 3003, /v1 (D-F8/D-F12/D-F17). NE-2: esqueleto + DDL da família + leitura publicada (prompt_onda_nfe_sefaz.md §15)",
  "scripts": {
    "dev": "tsx watch --require tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --forceExit",
    "db:migrate": "tsx --require tsconfig-paths/register scripts/migrate.ts",
    "token:dev": "tsx --require tsconfig-paths/register scripts/mint-dev-token.ts",
    "explain:leituras": "tsx --require tsconfig-paths/register scripts/explain-leituras.ts",
    "prove:001": "tsx --require tsconfig-paths/register scripts/prove-001-descartavel.ts"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "fiscal-api": "file:vendor/fiscal-api-4.0.0.tgz",
    "swagger-ui-express": "5.0.1",
    "xmllint-wasm": "5.3.0",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "29.7.0",
    "jsonwebtoken": "9.0.3",
    "supertest": "6.3.4",
    "ts-jest": "29.4.14",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
